{
  "name": "edumak-desktop",
  "version": "1.0.0",
  "description": "EDUMAK Windows desktop application",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "make:icon": "node scripts/make-icon.cjs",
    "dist:win": "npm run make:icon && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.2",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "org.edumak.library",
    "productName": "EDUMAK",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/edumak.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EDUMAK"
    }
  }
}
